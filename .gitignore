# 运行时数据（不提交）
data/logs/
data/sessions/
data/artifacts/
data/images/
data/web/profiles/
data/agent.db
data/agent.db-shm
data/agent.db-wal
*.db
*.db-shm
*.db-wal
# 主密钥（0600）：绝不能进版本库；密文就地存于上面各文件
data/keystore/
data/usage.jsonl
data/config.json
data/registered_projects.json
# 下面这些之前被跟踪，跑一次服务/测试就变脏，diff 里全是噪声
data/wf-json-errors.log
data/web_plugins.json
data/plugin_state.json
# web 族运行期产物（登录态 / 引擎健康 / 调用形态 / 频控）
data/web/logs/

# 旧 JSON 迁移后的残留（kvstore / sessions 迁移时自动改名，只用于回溯）
data/*.migrated
data/*.bak-*
data/*.bak

# 测试/运行产物（覆盖率是二进制，每跑一次就变脏）
backend/.coverage
backend/run-global.txt

# 依赖与环境
.server-venv/
.venv/
node_modules/
__pycache__/
*.pyc
.pytest_cache/

# 构建/临时产物
out/
frontend/dist/
backend/out/
.screenshots/
# vendored 上游源码（crawl4ai，浅克隆，进 git 会让仓库爆炸）与覆盖率产物
# 只忽略克隆目录本身；backend/vendor/ 下自研文件（pdf_text.py、docw_*.py 等）仍要进 git。
# 克隆来源与版本见 backend/vendor/README.md
backend/vendor/crawl4ai-src/
backend/coverage.json

# 项目用户数据（会话、工作流运行、子 Agent、产出物）
.agent/
projects/*/.agent/
backend/proj*/


# 项目内回收站：删除=移到 .trash（可恢复），不进版本库、也不在文件树里显示
.trash/
projects/*/.trash/

# 测试生成的工作流样例
data/workflows/assist-wf.json
data/workflows/exp-wf.json


# 测试误生成的盘符目录（Windows 路径在 Linux 下产生）
backend/D:/
.workbuddy

# 开发实例数据目录（8002 用，属运行数据）

# 2026-11-09：Remotion 插件已迁到 motion 项目（v3 就地登记制），
# 不再放仓库根 `plugins/`。它的第三方工程全部随 motion 项目走。
#
# 必须**根锚定**：写成 `plugins/` 会匹配任意层级，连 `backend/app/plugins/`
# （系统源码）都被误伤，导致这些文件无法 git add（实测踩到）。
/plugins/

# Remotion CLI 在仓库根跑时会把 Chrome Headless Shell 下到这里（220M，勿入库）
.remotion/

# 事件日志：无项目上下文的会话事件落到 data/events/（项目会话在 <project>/.agent/events/）
data/events/

# 事件库（断线续传用，运行数据不入库）
data/events.db
data/events.db-shm
data/events.db-wal

# 工作流运行产物（runs/）：临时产出，过一段时间就没用了，不入库
runs/

# 覆盖率产物（仓库根，每跑一次测试就变脏）
/coverage.json
